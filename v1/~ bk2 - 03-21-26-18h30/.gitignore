# ==================================================
# SYZYGY.VOID - Git Ignore
# Local junk, temp files, secrets, and private notes
# ==================================================

# --------------------------------------------------
# OS junk
# --------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --------------------------------------------------
# Editor / IDE
# --------------------------------------------------
.vscode/
.idea/
*.code-workspace

# --------------------------------------------------
# Logs / temp / backups
# --------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.old
*.orig
*.swp
*.swo

# --------------------------------------------------
# Environment / secrets
# --------------------------------------------------
.env
.env.*
!.env.example

# --------------------------------------------------
# Dependencies
# Keep ignored unless you truly need them committed
# --------------------------------------------------
/vendor/
/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --------------------------------------------------
# Build / cache / coverage
# --------------------------------------------------
/dist/
/build/
/cache/
/tmp/
/coverage/

# --------------------------------------------------
# PHP / server runtime noise
# --------------------------------------------------
*.cache
*.session
*.pid

# --------------------------------------------------
# Archive exports / local backup bundles
# --------------------------------------------------
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# --------------------------------------------------
# Design/source working files
# Ignore only if these are not part of live site use
# --------------------------------------------------
*.psd
*.ai
*.afdesign
*.xcf

# --------------------------------------------------
# Laragon / local-only server noise
# --------------------------------------------------
/.storage/
/sessions/
/logs/

# --------------------------------------------------
# Private / scratch documentation
# Keep polished docs in Git, ignore private notes
# --------------------------------------------------
/docs/private/
/notes-local/
/scratch/
*.local.md

# --------------------------------------------------
# Optional runtime uploads
# Uncomment ONLY if these are user-generated
# and should not be versioned/deployed
# --------------------------------------------------
# /uploads/
# /public/uploads/
# /assets/uploads/

# --------------------------------------------------
# Optional raw/source asset folders
# Uncomment ONLY if these folders are NOT the live site source
# --------------------------------------------------
# /assets/src/
# /assets/raw/
# /assets/img-source/

# --------------------------------------------------
# Optional local export / dump folders
# Uncomment if you use them for one-off local exports
# --------------------------------------------------
# /exports/
# /backups/
# /patch-zips/
# /tmp-work/

# --------------------------------------------------
# Never ignore core site code by accident
# These are intentionally tracked:
# - index.php
# - data/
# - sections/
# - includes/
# - assets/css/
# - assets/js/
# - live production image folders
# - README.md
# - docs/
# - .cpanel.yml
# --------------------------------------------------